{
  "id": "imagehost",
  "name": "图床",
  "version": "0.5.0",
  "entry": "main.wasm",
  "description": "基于 rclone 的图床：上传图片拿直链，可再换短链。",
  "author": "h897105167",
  "tags": ["图床", "图片", "rclone", "上传", "短链"],
  "platform": "any",
  "builtin": false,
  "http_entry": true,
  "capabilities": ["kv", "ui", "fs", "http", "rclone", "env"],
  "plugin_setting": {
    "version": 1,
    "summary": "把本地图片传到 rclone 远程，生成直链；需要时再换一条短链。",
    "on_start": "state",
    "on_exit": "exit",
    "controls": [
      { "kind": "group", "label": "图床工具（上传 → 直链 → 短链）" },
      {
        "kind": "field",
        "key": "remote",
        "label": "存储的远程",
        "field": "select",
        "dynamic": true,
        "width": 260,
        "line": "s1",
        "placeholder": "选择一个 rclone 远程"
      },
      {
        "kind": "action",
        "key": "refresh-remotes",
        "label": "刷新远程",
        "style": "secondary",
        "line": "s1"
      },
      {
        "kind": "field",
        "key": "path",
        "label": "上传目录",
        "field": "path",
        "width": 430,
        "line": "s2",
        "placeholder": "留空 = 远程根，如 image_bed"
      },
      {
        "kind": "field",
        "key": "upload_path",
        "label": "上传图片路径",
        "field": "text",
        "width": 330,
        "line": "s3",
        "placeholder": "本机图片文件的完整路径"
      },
      {
        "kind": "action",
        "key": "pick",
        "label": "选择文件…",
        "style": "secondary",
        "line": "s3",
        "dialog_title": "选择要上传的图片",
        "filters": ["png", "jpg", "jpeg", "gif", "webp", "bmp"]
      },
      {
        "kind": "field",
        "key": "dedupe",
        "label": "去重",
        "field": "bool",
        "default": "true",
        "line": "s4"
      },
      {
        "kind": "hint",
        "key": "dedupe-tip",
        "text": "去重：上传目录里已有同名文件就提示并取消上传（不勾选则自动改名成「名字 (1).png」）。"
      },
      {
        "kind": "field",
        "key": "short_tpl",
        "label": "短链模板",
        "field": "select",
        "options": ["不选择", "模板一"],
        "width": 140,
        "line": "s5"
      },
      { "kind": "group", "label": "模板一参数" },
      {
        "kind": "field",
        "key": "short_fmt",
        "label": "返回格式",
        "field": "select",
        "options": ["无", "JSON", "JSONP"],
        "width": 110,
        "line": "t1"
      },
      {
        "kind": "field",
        "key": "short_method",
        "label": "请求方式",
        "field": "select",
        "options": ["GET", "POST"],
        "width": 100,
        "line": "t1"
      },
      {
        "kind": "field",
        "key": "short_rate",
        "label": "每秒上限",
        "field": "number",
        "width": 90,
        "line": "t1",
        "placeholder": "4"
      },
      {
        "kind": "field",
        "key": "short_callback",
        "label": "JSONP 回调",
        "field": "text",
        "width": 120,
        "line": "t1",
        "placeholder": "callback"
      },
      {
        "kind": "field",
        "key": "short_url",
        "label": "请求地址",
        "field": "text",
        "width": 260,
        "line": "t2",
        "placeholder": "http://api.ft12.com/api.php"
      },
      {
        "kind": "field",
        "key": "short_key",
        "label": "api_key",
        "field": "password",
        "width": 300,
        "line": "t2",
        "placeholder": "模板一必须填 api_key"
      },
      {
        "kind": "hint",
        "key": "short-tip",
        "text": "模板一：请求地址 + url + apikey；返回格式「无」表示服务端直接回纯文本链接。填好后点「保存设置」记住。"
      },
      {
        "kind": "action",
        "key": "run",
        "label": "生成直链",
        "style": "primary",
        "line": "b1"
      },
      { "kind": "action", "key": "save", "label": "保存设置", "style": "secondary", "line": "b1" },
      { "kind": "action", "key": "copy-link", "label": "复制直链", "style": "secondary", "line": "b1" },
      {
        "kind": "field",
        "key": "last_link",
        "label": "直链",
        "field": "text",
        "width": 430,
        "line": "r1",
        "placeholder": "上传后在这里显示"
      },
      {
        "kind": "action",
        "key": "copy-short",
        "label": "复制短链",
        "style": "secondary",
        "line": "r2"
      },
      {
        "kind": "field",
        "key": "last_short",
        "label": "短链",
        "field": "text",
        "width": 430,
        "line": "r2",
        "placeholder": "选「模板一」并上传后会在这里显示"
      },
      { "kind": "status", "key": "state", "text": "状态", "lamp": true },
      {
        "kind": "hint",
        "key": "link-tip",
        "text": "直链来源：K-Vault 等站点型远程由 rclone 上传后直接给出站点链接；普通远程退回本机服务的代理链接 http://127.0.0.1:<port>/plugin/imagehost/i/<远程>:<路径>，需要本程序在运行。"
      }
    ]
  }
}
