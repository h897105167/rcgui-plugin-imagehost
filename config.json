{
  "id": "imagehost",
  "name": { "zh": "图床", "en": "Image host" },
  "version": "0.7.1",
  "entry": "main.wasm",
  "description": {
    "zh": "基于 rclone 的图床：上传图片拿直链，可再换短链。",
    "en": "An rclone-backed image host: upload an image, get a direct link, optionally shorten it."
  },
  "author": "h897105167",
  "tags": {
    "zh": ["图床", "图片", "rclone", "上传", "短链"],
    "en": ["image host", "image", "rclone", "upload", "short link"]
  },
  "min_gui_version": "0.3.0",
  "platform": "any",
  "builtin": false,
  "http_entry": true,
  "capabilities": ["kv", "ui", "fs", "http", "rclone", "env"],
  "plugin_setting": {
    "version": 2,
    "summary": {
      "zh": "把本地图片传到 rclone 远程，生成直链；需要时再换一条短链。",
      "en": "Upload a local image to an rclone remote and get a direct link; shorten it when you want."
    },
    "on_start": "state",
    "on_exit": "exit",
    "pages": [
      { "id": "upload", "label": { "zh": "上传", "en": "Upload" } },
      { "id": "storage", "label": { "zh": "存储与链接", "en": "Storage & Link" } },
      { "id": "compress", "label": { "zh": "压缩与命名", "en": "Compression & Naming" } },
      { "id": "http", "label": { "zh": "HTTP 接入", "en": "HTTP Access" } },
      { "id": "advanced", "label": { "zh": "高级", "en": "Advanced" } }
    ],
    "controls": [
      {
        "kind": "group",
        "key": "g-title",
        "page": "upload",
        "label": { "zh": "选择远程与文件", "en": "Pick remote and file" }
      },
      {
        "kind": "field",
        "key": "remote",
        "page": "upload",
        "label": { "zh": "存储远程", "en": "Storage remote" },
        "field": "select",
        "dynamic": true,
        "width": 260,
        "line": "s1",
        "placeholder": { "zh": "选择存图的远程", "en": "Pick the remote that stores images" }
      },
      {
        "kind": "action",
        "key": "refresh-remotes",
        "page": "upload",
        "label": { "zh": "刷新列表", "en": "Refresh list" },
        "style": "secondary",
        "line": "s1"
      },
      {
        "kind": "field",
        "key": "upload_path",
        "page": "upload",
        "label": { "zh": "图片路径", "en": "Image path" },
        "field": "text",
        "width": 330,
        "line": "s3",
        "placeholder": { "zh": "本机图片的完整路径", "en": "Full path of a local image" }
      },
      {
        "kind": "action",
        "key": "pick",
        "page": "upload",
        "label": { "zh": "选择图片…", "en": "Choose image…" },
        "style": "secondary",
        "line": "s3",
        "dialog_title": { "zh": "选择要上传的图片", "en": "Choose an image to upload" },
        "filters": ["png", "jpg", "jpeg", "gif", "webp", "bmp"]
      },
      {
        "kind": "action",
        "key": "run",
        "page": "upload",
        "label": { "zh": "生成直链", "en": "Get direct link" },
        "style": "primary",
        "line": "b1"
      },
      {
        "kind": "action",
        "key": "save",
        "page": "upload",
        "label": { "zh": "保存设置", "en": "Save settings" },
        "style": "secondary",
        "line": "b1"
      },
      {
        "kind": "field",
        "key": "path",
        "page": "storage",
        "label": { "zh": "存储目录", "en": "Storage folder" },
        "field": "path",
        "width": 430,
        "line": "s2",
        "placeholder": {
          "zh": "留空 = 远程根目录，例如 image_bed",
          "en": "Empty = remote root, e.g. image_bed"
        }
      },
      {
        "kind": "field",
        "key": "short_tpl",
        "page": "storage",
        "label": { "zh": "短链模板", "en": "Short-link template" },
        "field": "select",
        "options": [
          { "value": "不选择", "label": { "zh": "不选择", "en": "None" } },
          { "value": "模板一", "label": { "zh": "模板一", "en": "Template 1" } }
        ],
        "width": 140,
        "line": "s5"
      },
      {
        "kind": "field",
        "key": "last_link",
        "page": "storage",
        "label": { "zh": "直链", "en": "Direct link" },
        "field": "text",
        "width": 430,
        "line": "r1",
        "placeholder": { "zh": "上传后显示在这里", "en": "Appears here after upload" }
      },
      {
        "kind": "action",
        "key": "copy-link",
        "page": "storage",
        "label": { "zh": "复制直链", "en": "Copy direct link" },
        "style": "secondary",
        "line": "r1"
      },
      {
        "kind": "field",
        "key": "last_short",
        "page": "storage",
        "label": { "zh": "短链", "en": "Short link" },
        "field": "text",
        "width": 430,
        "line": "r2",
        "placeholder": {
          "zh": "选了「模板一」并上传后显示在这里",
          "en": "Appears here after choosing “Template 1” and uploading"
        }
      },
      {
        "kind": "action",
        "key": "copy-short",
        "page": "storage",
        "label": { "zh": "复制短链", "en": "Copy short link" },
        "style": "secondary",
        "line": "r2"
      },
      {
        "kind": "hint",
        "key": "link-tip",
        "page": "storage",
        "text": {
          "zh": "直链来源：站点型远程（如 K-Vault）由 rclone 上传后直接给站点链接；普通远程回退到本机代理 http://127.0.0.1:<端口>/plugin/imagehost/i/<远程>:<路径>，需要本程序在运行。",
          "en": "Direct links: site-style remotes (K-Vault and the like) return their own site link from rclone; plain remotes fall back to this app's proxy http://127.0.0.1:<port>/plugin/imagehost/i/<remote>:<path>, which needs the app running."
        }
      },
      {
        "kind": "field",
        "key": "max_mb",
        "page": "compress",
        "label": { "zh": "体积上限 MB", "en": "Size limit (MB)" },
        "field": "number",
        "width": 90,
        "line": "h1",
        "placeholder": "20"
      },
      {
        "kind": "field",
        "key": "compress",
        "page": "compress",
        "label": { "zh": "超限先压缩", "en": "Compress if oversized" },
        "field": "bool",
        "default": "true",
        "line": "h1"
      },
      {
        "kind": "field",
        "key": "dedupe",
        "page": "compress",
        "label": { "zh": "去重", "en": "Deduplicate" },
        "field": "bool",
        "default": "true",
        "line": "s4"
      },
      {
        "kind": "hint",
        "key": "dedupe-tip",
        "page": "compress",
        "text": {
          "zh": "去重：上传目录已有同名文件时提示并取消上传；不勾选则自动改名成「名字 (1).png」。",
          "en": "Deduplicate: when the storage folder already holds that name, warn and cancel the upload; unticked, the file is renamed to “name (1).png”."
        }
      },
      {
        "kind": "group",
        "key": "g-http",
        "page": "http",
        "label": { "zh": "上传服务", "en": "Upload service" }
      },
      {
        "kind": "field",
        "key": "http_port",
        "page": "http",
        "label": { "zh": "本机端口", "en": "Local port" },
        "field": "number",
        "width": 120,
        "placeholder": {
          "zh": "点「检测端口」自动填；读不到就手填 RCGUI 在用的端口",
          "en": "Filled in by “Detect port”; type RCGUI's port if that fails"
        }
      },
      {
        "kind": "field",
        "key": "http_url",
        "page": "http",
        "label": { "zh": "上传地址", "en": "Upload URL" },
        "field": "text",
        "width": 430,
        "line": "h2",
        "placeholder": {
          "zh": "点「检测端口」自动填写",
          "en": "Filled in by “Detect port”"
        }
      },
      {
        "kind": "action",
        "key": "detect-port",
        "page": "http",
        "label": { "zh": "检测端口", "en": "Detect port" },
        "style": "secondary",
        "line": "h2"
      },
      {
        "kind": "hint",
        "key": "http-tip",
        "page": "http",
        "text": {
          "zh": "端口先自动从宿主配置里读；读不到就在「本机端口」里手填 RCGUI 实际在用的端口（默认 5273），填完点「检测端口」重算上传地址。主程序已不提供 HTTP 设置页，填端口这件事只在插件这一页做。外部客户端探测 http://127.0.0.1:<端口>/plugin/imagehost/ping，上传走 POST /plugin/imagehost/upload。超过体积上限的图先压缩再传；选了短链模板就返回短链，取不到时回退直链。",
          "en": "The port is read from the host config first; if that fails, type the port RCGUI is actually listening on (5273 by default) into “Local port”, then click “Detect port” to recompute the upload URL. The app no longer offers an HTTP settings page, so this page is where the port is set. External clients probe http://127.0.0.1:<port>/plugin/imagehost/ping and upload with POST /plugin/imagehost/upload. Images over the size limit are compressed first; with a short-link template the short link is returned, falling back to the direct link."
        }
      },
      {
        "kind": "group",
        "key": "g-tpl1",
        "page": "advanced",
        "label": { "zh": "模板一参数", "en": "Template 1 settings" }
      },
      {
        "kind": "field",
        "key": "short_fmt",
        "page": "advanced",
        "label": { "zh": "返回格式", "en": "Response format" },
        "field": "select",
        "options": [{ "value": "无", "label": { "zh": "无", "en": "None" } }, "JSON", "JSONP"],
        "width": 110,
        "line": "t1"
      },
      {
        "kind": "field",
        "key": "short_method",
        "page": "advanced",
        "label": { "zh": "请求方式", "en": "Method" },
        "field": "select",
        "options": ["GET", "POST"],
        "width": 100,
        "line": "t1"
      },
      {
        "kind": "field",
        "key": "short_rate",
        "page": "advanced",
        "label": { "zh": "每秒上限", "en": "Calls per second" },
        "field": "number",
        "width": 90,
        "line": "t1",
        "placeholder": "4"
      },
      {
        "kind": "field",
        "key": "short_callback",
        "page": "advanced",
        "label": { "zh": "JSONP 回调", "en": "JSONP callback" },
        "field": "text",
        "width": 120,
        "line": "t1",
        "placeholder": "callback"
      },
      {
        "kind": "field",
        "key": "short_url",
        "page": "advanced",
        "label": { "zh": "请求地址", "en": "Endpoint" },
        "field": "text",
        "width": 260,
        "line": "t2",
        "placeholder": "http://api.ft12.com/api.php"
      },
      {
        "kind": "field",
        "key": "short_key",
        "page": "advanced",
        "label": "api_key",
        "field": "password",
        "width": 300,
        "line": "t2",
        "placeholder": {
          "zh": "模板一必填 api_key",
          "en": "Template 1 needs an api_key"
        }
      },
      {
        "kind": "hint",
        "key": "short-tip",
        "page": "advanced",
        "text": {
          "zh": "模板一：请求地址 + url + apikey；返回格式选「无」表示服务端直接回纯文本链接。填好后点「保存设置」记住。",
          "en": "Template 1: endpoint + url + apikey; “None” means the service returns the plain-text link. Click “Save settings” to keep it."
        }
      },
      { "kind": "status", "key": "state", "text": { "zh": "状态", "en": "Status" }, "lamp": true }
    ]
  }
}
